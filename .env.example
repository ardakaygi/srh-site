# Copy to .env and adjust for your environment.
# Dev default is SQLite (zero-config). Swap to a postgresql:// URL for production
# — see MASTER_PROMPT.md §3.
DATABASE_URL="file:./dev.db"

# Verimor SMS API (src/lib/sms.ts) - leave unset to use the no-op stub
# provider in dev. Get these from the Verimor account panel; never commit
# real values here.
VERIMOR_USERNAME=
VERIMOR_PASSWORD=
VERIMOR_SOURCE_ADDR=
