# Copy to .env and adjust for your environment.
# Dev default is SQLite (zero-config). Swap to a postgresql:// URL for production
# — see MASTER_PROMPT.md §3.
DATABASE_URL="file:./dev.db"

# Verimor SMS API (src/lib/sms.ts) - leave unset to use the no-op stub
# provider in dev. Get these from the Verimor account panel; never commit
# real values here.
VERIMOR_USERNAME=
VERIMOR_PASSWORD=
VERIMOR_SOURCE_ADDR=

# Admin panel (/admin, src/lib/adminAuth.ts). Both are required for login
# to work at all - without them checkAdminPassword() always fails closed.
# ADMIN_PASSWORD: the single admin login password, plaintext here on
#   purpose (it's the source of truth, compared with a constant-time
#   check) - pick something long and random, never reuse another password.
# ADMIN_SESSION_SECRET: a separate random secret used only to sign session
#   cookies. Keep it different from ADMIN_PASSWORD so rotating one doesn't
#   force rotating the other. Generate with e.g. `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
