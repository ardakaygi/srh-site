# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example documents the required keys with no real
# secrets, so it's tracked on purpose - never remove this exception)
.env*
!.env.example

# local SQLite dev database
/prisma/*.db
/prisma/*.db-journal

# admin-uploaded images (src/lib/imageUpload.ts) - runtime content, not
# source; production needs a persistent volume/object storage for this
# directory, same caveat as the SQLite db above.
/public/uploads/

# abandoned PHP/MySQL rewrite (2026-08-28) - kept on disk as reference, not
# part of the deployed Next.js app; excluded so it never gets swept into a
# commit by a future `git add -A`.
/php-site/
/scripts/export-seed-json.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
