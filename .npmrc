# cPanel's "Setup Node.js App" runs the app (and often `npm install`) with
# NODE_ENV=production, which makes npm silently skip devDependencies by
# default. That's fine here since every package actually required to run
# `npm run build` was moved into "dependencies" (see package.json) - but
# this is kept as a second safety net in case a future devDependency ends
# up needed at build time again.
production=false
