// Prisma schema for Samsun Robot Hastanesi.
//
// Production datasource is MySQL (samsunro_srh on the cPanel host, 2026-08-28
// - standard/free on cPanel, per the business owner's confirmed preference).
// Local dev previously used SQLite for zero-config convenience; since the
// two engines diverge on migration SQL, the pre-2026-08-28 SQLite migration
// history under prisma/migrations/ is not applied on this datasource - the
// production database was created fresh via `prisma db push` instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// A Turkish province (il). One row -> one programmatic SEO landing page
// at /[slug]-robot-supurge-servisi.
model Province {
  id                String   @id @default(cuid())
  slug              String   @unique // e.g. "samsun"
  name              String // e.g. "Samsun"
  plateCode         String   @unique // e.g. "55"
  region            String // e.g. "Karadeniz" - used for nearby-province linking
  leadTimeLabel     String // e.g. "1-2 iş günü" - realistic bucketed estimate, not fabricated precision
  regionalIntro     String // genuinely regional paragraph (climate/usage angle) - must not be a template
  topBrandSlugs     String // JSON-encoded string[] of 3-5 Brand.slug most requested from this region
  faqJson           String // JSON-encoded {question, answer}[] - province-specific, not copy-pasted everywhere
  // Real, license-verified landmark photo shown on this province's page
  // (admin-uploadable, 2026-08-28 - migrated from the old static
  // src/lib/provinceLandmarks.ts map so any of the 81 provinces can have
  // one, not just the first 6). Null = no photo, page falls back to the
  // single-column layout (see ProvincePageContent.tsx).
  landmarkImage     String?
  landmarkAlt       String?
  landmarkCredit    String? // e.g. "Fotoğraf: X · CC BY-SA 4.0" - required whenever landmarkImage is set to a non-owned photo
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  serviceRequests ServiceRequest[]
}

// A robot vacuum brand. One row -> one programmatic SEO landing page
// at /[slug]-robot-supurge-servisi.
model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "roborock"
  name        String // e.g. "Roborock"
  intro       String // brand-specific value proposition paragraph
  faultsJson  String // JSON-encoded {title, description}[] - brand-differentiated common faults
  faqJson     String // JSON-encoded {question, answer}[]
  // Admin-uploadable logo (2026-08-28 - migrated from the hardcoded
  // BRAND_LOGO_MAP/public/brand-logos which only covered 6 brands). Null
  // = shown as plain text everywhere a logo would go, never a fabricated
  // placeholder image.
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models          Model[]
  serviceRequests ServiceRequest[]
}

// A specific model of a brand. One row -> one micro-landing page
// at /model/[brandSlug]-[modelSlug].
model Model {
  id            String   @id @default(cuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id])
  slug          String // e.g. "s7" - unique within a brand, combined as brandSlug-modelSlug in the URL
  name          String // e.g. "Roborock S7"
  suctionPa     Int? // suction power, Pascals - nullable, not every model has published specs
  batteryMah    Int?
  runtimeMin    Int?
  commonIssues  String // JSON-encoded {title, description}[] - model-specific, distinct from the brand page's list
  partsNote     String // spare parts / battery options blurb specific to this model
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([brandId, slug])
}

// Blog post, editable from /admin/blog. Migrated from the static
// src/lib/blogPosts.ts array (2026-08-28) so content editors don't need a
// code deploy to publish/edit a post - see decisions.md.
model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  category      String
  coverImage    String
  publishedAt   DateTime
  readMinutes   Int
  sectionsJson  String // JSON-encoded {heading, body}[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// General FAQ shown on /sss, editable from /admin/sss. Migrated from a
// hardcoded array in src/app/sss/page.tsx (2026-08-28).
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Small, explicit set of editable marketing-copy strings (NOT a generic
// freeform CMS - only keys the admin UI and site code both know about are
// meaningful). Value is plain text, or JSON-encoded when isJson is true
// (e.g. the rotating hero phrases array). See src/lib/siteSettings.ts.
model SiteSetting {
  key       String   @id
  value     String
  isJson    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

enum ServiceRequestStatus {
  RECEIVED
  DIAGNOSED
  REPAIRING
  TESTING
  SHIPPED
  DELIVERED
}

// A customer's service request, created via the multi-step form.
model ServiceRequest {
  id              String               @id @default(cuid())
  trackingCode    String               @unique // shown to the customer for /servis-takip lookups
  brandId         String
  brand           Brand                @relation(fields: [brandId], references: [id])
  modelName       String? // free-text fallback if the exact model isn't in the Model table
  faultDescription String
  customerName    String
  customerPhone   String
  provinceId      String
  province        Province             @relation(fields: [provinceId], references: [id])
  addressLine     String
  kvkkConsent     Boolean              @default(false) // must be explicitly true at submit time - never pre-checked in the UI
  status          ServiceRequestStatus @default(RECEIVED)
  carrierName     String? // set once a CarrierProvider shipment is created - which carrier is not yet decided (MASTER_PROMPT.md §4)
  carrierTrackingUrl String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  statusEvents ServiceRequestStatusEvent[]
}

// Append-only status history so /servis-takip can show a timeline, not just current status.
model ServiceRequestStatusEvent {
  id               String               @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest       @relation(fields: [serviceRequestId], references: [id])
  status           ServiceRequestStatus
  note             String? // Turkish, customer-facing note for this status change
  createdAt        DateTime             @default(now())
}
